# Enables the AI coach. Without it the app falls back to a built-in summary.
OPENAI_API_KEY=
# Optional: override the model used by the coach.
OPENAI_MODEL=

# Supabase (login, saved hands, usage events). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Metrics page (/metrics). Server only: never prefix these with NEXT_PUBLIC_.
# A Supabase secret key, used on the server to read the write-only events table.
SUPABASE_SECRET_KEY=
# Password for /metrics (any user name). Without it the page is switched off.
METRICS_PASSWORD=
